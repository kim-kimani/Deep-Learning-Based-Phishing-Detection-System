# Deep Learning Spam Detection System Configuration
# Copy this file to .env and update the values

# Groq API Configuration (for LLM validation)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Configuration (optional - for LLM validation)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Configuration (optional - for LLM validation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Django Configuration
DEBUG=True
SECRET_KEY=your_django_secret_key_here_change_this_in_production

# Database Configuration
DATABASE_URL=sqlite:///db.sqlite3

# Model Configuration
MODEL_CACHE_DIR=./model_cache
ENABLE_GPU=auto
ENABLE_LLM_VALIDATION=False

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/django.log

# Performance Configuration
BATCH_SIZE=32
MAX_SEQUENCE_LENGTH=512
MODEL_CONFIDENCE_THRESHOLD=0.7

# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=True

# Redis Configuration (optional - for caching)
REDIS_URL=redis://localhost:6379/0

# Celery Configuration (optional - for background tasks)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
